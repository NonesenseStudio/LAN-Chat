# 仅供本机反向代理访问的生产 Node 进程
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
LAN_CHAT_TRUST_PROXY=1

# 初始容量值，可按主机资源调整；修改后需重新验收代理与内存边界
LAN_CHAT_MAX_ATTACHMENT_BYTES=20971520
LAN_CHAT_MAX_TOTAL_ATTACHMENT_BYTES=268435456
LAN_CHAT_MAX_TOTAL_MESSAGE_BYTES=536870912
LAN_CHAT_MAX_MESSAGES_PER_ROOM=5000
LAN_CHAT_MAX_ROOMS=200
LAN_CHAT_MAX_MEMBERS_PER_ROOM=200
LAN_CHAT_MAX_CONNECTIONS=200
LAN_CHAT_MAX_GUESTS=1000

# 仅填写经过完整代理链路验证的字节上限
# LAN_CHAT_PROXY_WS_MESSAGE_LIMIT=
# LAN_CHAT_MAX_WS_MESSAGE_BYTES=
# LAN_CHAT_ALLOWED_ORIGINS=https://chat.example.com
